            IF pg_catalog.has_sequence_privilege(caller,relation_oid,'SELECT,UPDATE')
               OR pg_catalog.has_sequence_privilege(caller,relation_oid,'USAGE') THEN
                RAISE EXCEPTION 'Sequence ACL mismatch: % / %',r.name,caller;
            END IF;
