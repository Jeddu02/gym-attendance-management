            WHERE c.oid=relation_oid AND c.relkind='S' AND c.relowner=(SELECT oid FROM pg_catalog.pg_roles
            WHERE rolname=CASE WHEN target THEN 'gym_data_owner' ELSE 'postgres' END)) THEN
