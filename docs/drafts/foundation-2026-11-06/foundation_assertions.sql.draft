            LATERAL pg_catalog.aclexplode(COALESCE(c.relacl,pg_catalog.acldefault('S',c.relowner))) a
            WHERE c.oid=relation_oid AND a.grantee<>c.relowner) THEN
            RAISE EXCEPTION 'Unreviewed sequence ACL: %',r.name;
        END IF;
    END LOOP;
