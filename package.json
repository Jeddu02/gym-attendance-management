{
  "name": "gym-attendance-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test": "node --test tests/source-security.test.mjs tests/csv.test.mjs tests/entrance-link.test.mjs tests/money.test.mjs tests/operation-error.test.mjs tests/function-error.test.mjs tests/edge-handlers.test.mjs tests/hosting-diagnostics.test.mjs tests/public-entry-contract.test.mjs tests/offline-claim-contract.test.mjs",
    "test:recovery-request": "node --test tests/walkin-recovery.test.mjs tests/walkin-ingress.test.mjs",
    "test:security": "node scripts/check-source-security.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:dev": "node --test tests/vite-development.test.mjs",
    "test:database": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-database.ps1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "supabase": "^2.122.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0"
  }
}
